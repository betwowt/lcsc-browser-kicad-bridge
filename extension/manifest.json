{
  "manifest_version": 3,
  "name": "LCSC → KiCad Bridge",
  "version": "1.2.0",
  "description": "从立创商品页把元件导入本地 KiCad 工程",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.szlcsc.com/*",
        "*://*.lcsc.com/*",
        "*://*.lcsc.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "导入到 KiCad"
  }
}
